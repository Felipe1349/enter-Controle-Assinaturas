-- Controle de Assinaturas: schema base + RLS (schema public estava vazio)

create table public.empresas (
  id uuid primary key default gen_random_uuid(),
  nome text not null unique,
  ativo boolean not null default true,
  created_at timestamptz not null default now()
);

create table public.planos (
  id uuid primary key default gen_random_uuid(),
  nome text not null unique,
  valor_padrao numeric(10,2) not null,
  intervalo_dias integer not null,
  ordem integer not null default 0,
  ativo boolean not null default true,
  created_at timestamptz not null default now(),
  constraint planos_intervalo_dias_positivo check (intervalo_dias > 0),
  constraint planos_valor_padrao_nao_negativo check (valor_padrao >= 0)
);

create table public.clientes (
  id uuid primary key default gen_random_uuid(),
  nome_completo text not null,
  email text,
  whatsapp text,
  empresa_id uuid references public.empresas(id) on delete set null,
  plano_id uuid references public.planos(id) on delete set null,
  valor numeric(10,2) not null default 0,
  data_cadastro date not null default current_date,
  proximo_vencimento date not null,
  status text not null default 'ativo',
  observacoes text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  constraint clientes_status_valido check (status in ('ativo', 'inativo')),
  constraint clientes_valor_nao_negativo check (valor >= 0)
);

create table public.pagamentos (
  id uuid primary key default gen_random_uuid(),
  cliente_id uuid not null references public.clientes(id) on delete cascade,
  valor_pago numeric(10,2) not null,
  data_pagamento date not null default current_date,
  forma_pagamento text not null,
  observacao text,
  vencimento_anterior date,
  vencimento_novo date,
  created_at timestamptz not null default now(),
  constraint pagamentos_forma_valida check (forma_pagamento in ('pix', 'cartao', 'dinheiro', 'transferencia')),
  constraint pagamentos_valor_positivo check (valor_pago > 0)
);

create table public.configuracoes (
  id uuid primary key default gen_random_uuid(),
  chave text not null unique,
  valor text,
  created_at timestamptz not null default now()
);

create index clientes_empresa_id_idx on public.clientes (empresa_id);
create index clientes_plano_id_idx on public.clientes (plano_id);
create index clientes_proximo_vencimento_idx on public.clientes (proximo_vencimento);
create index clientes_status_idx on public.clientes (status);
create index pagamentos_cliente_id_idx on public.pagamentos (cliente_id);
create index pagamentos_data_pagamento_idx on public.pagamentos (data_pagamento);

create function public.set_updated_at()
returns trigger
language plpgsql
as $$
begin
  new.updated_at = now();
  return new;
end;
$$;

create trigger clientes_set_updated_at
before update on public.clientes
for each row execute function public.set_updated_at();

alter table public.empresas enable row level security;
alter table public.planos enable row level security;
alter table public.clientes enable row level security;
alter table public.pagamentos enable row level security;
alter table public.configuracoes enable row level security;

create policy empresas_acesso_app on public.empresas for all to anon, authenticated using (true) with check (true);
create policy planos_acesso_app on public.planos for all to anon, authenticated using (true) with check (true);
create policy clientes_acesso_app on public.clientes for all to anon, authenticated using (true) with check (true);
create policy pagamentos_acesso_app on public.pagamentos for all to anon, authenticated using (true) with check (true);
create policy configuracoes_acesso_app on public.configuracoes for all to anon, authenticated using (true) with check (true);
